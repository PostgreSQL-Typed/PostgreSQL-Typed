{
	"name": "@postgresql-typed/root",
	"private": true,
	"version": "0.0.0",
	"description": "PostgreSQL Typed Monorepo",
	"license": "MPL-2.0",
	"author": {
		"name": "Bas950",
		"email": "me@bas950.com",
		"url": "https://bas950.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PostgreSQL-Typed/PostgreSQL-Typed.git"
	},
	"bugs": {
		"url": "https://github.com/PostgreSQL-Typed/PostgreSQL-Typed/issues"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky install configs/.husky",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"clean": "rimraf ./packages/*/{lib,dist,.turbo,coverage,.output,.nuxt}",
		"clean:all": "pnpm clean && rimraf ./packages/*/node_modules node_modules",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch",
		"test:ci": "turbo run test:ci --force --no-cache",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"badges": "monorepo-coverage-badges",
		"badges:ci": "monorepo-coverage-badges --ci",
		"ci:version": "changeset version && pnpm install --frozen-lockfile false",
		"prerelease": "pnpm clean && pnpm install && pnpm build",
		"release": "pnpm run prerelease && changeset publish",
		"snapshot": "pnpm prerelease && changeset version --snapshot preview && pnpm install && changeset publish --tag preview",
		"changeset": "changeset"
	},
	"workspaces": [
		"packages/*"
	],
	"devDependencies": {
		"@changesets/changelog-github": "^0.4.8",
		"@changesets/cli": "^2.26.2",
		"@recodive/configs": "^1.1.2",
		"@recodive/eslint-config": "^1.4.0",
		"@rushstack/eslint-patch": "^1.5.1",
		"@vitest/coverage-v8": "^0.34.6",
		"@vitest/ui": "^0.34.6",
		"commitlint": "^18.2.0",
		"eslint": "^8.52.0",
		"husky": "^8.0.3",
		"lint-staged": "^15.0.2",
		"monorepo-coverage-badges": "^1.0.3",
		"prettier": "^3.0.3",
		"rimraf": "^5.0.5",
		"source-map-support": "^0.5.21",
		"turbo": "^2.9.14",
		"typescript": "^5.2.2",
		"vitest": "0.34.6"
	},
	"packageManager": "pnpm@8.9.0",
	"engines": {
		"node": ">=16",
		"pnpm": ">=8.6.0"
	},
	"eslintConfig": {
		"extends": "./configs/.eslintrc.js"
	},
	"monorepo-coverage-badges": {
		"mdFiles": {
			"**/*.md": {
				"coverage": {
					"logo": "vitest"
				},
				"statements": {
					"logo": "vitest"
				},
				"branches": {
					"logo": "vitest"
				},
				"functions": {
					"logo": "vitest"
				},
				"lines": {
					"logo": "vitest"
				}
			}
		}
	},
	"pnpm": {
		"overrides": {
			"dompurify@3.0.6": "3.4.17",
			"immutable@4.3.4": "4.3.9",
			"simple-git@3.20.0": "3.36.0",
			"@nuxt/devtools@1.0.0": "1.3.9",
			"form-data@2.3.3": "2.5.6",
			"form-data@4.0.0": "4.0.6",
			"shell-quote@1.8.1": "1.9.0",
			"flatted@3.2.9": "3.4.2",
			"h3@1.8.2": "1.15.6",
			"rollup@3.29.4": "3.30.0",
			"@75lb/deep-merge@1.1.1": "1.1.2",
			"joi@17.11.0": "17.13.7",
			"minimatch@3.0.8": "9.0.7",
			"minimatch@3.1.2": "3.1.4",
			"minimatch@5.1.6": "5.1.8",
			"minimatch@9.0.3": "9.0.7",
			"node-forge@1.3.1": "1.4.0",
			"source-map-js@1.0.2": "1.2.2",
			"ws@8.14.2": "8.21.0",
			"nanoid@3.3.6": "3.3.18",
			"svgo@3.0.2": "3.3.5",
			"lodash@4.17.21": "4.18.0",
			"lodash-es@4.17.21": "4.18.0",
			"brace-expansion@1.1.11": "1.1.20",
			"brace-expansion@2.0.1": "2.1.6",
			"cross-spawn@7.0.3": "7.0.5",
			"tmp@0.2.1": "0.2.7",
			"braces@3.0.2": "3.0.3",
			"browserslist@4.22.1": "4.28.7",
			"defu@6.1.3": "6.1.5",
			"fflate@0.8.1": "0.8.3",
			"glob@10.3.10": "10.5.0",
			"js-yaml@3.14.1": "3.15.2",
			"js-yaml@4.1.0": "4.3.2",
			"launch-editor@2.6.1": "2.14.2",
			"picomatch@2.3.1": "2.3.2",
			"postcss@8.4.31": "8.5.18",
			"@vue/server-renderer@3.3.7": "3.5.42",
			"mermaid@10.6.0": "10.9.3"
		}
	}
}
